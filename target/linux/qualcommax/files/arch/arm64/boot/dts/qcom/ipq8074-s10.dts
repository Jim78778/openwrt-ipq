// SPDX-License-Identifier: GPL-2.0-only
/dts-v1/;

/*
 * OpenWrt mainline-style DTS
 * Converted from QSDK (closed-source) DTS for Swaiot CPE-S10-SKY
 *
 * Key changes:
 *  - Removed NSS / ESS / qcom,nss-dp / MACsec nodes
 *  - Converted to Linux mainline + DSA-compatible layout
 *  - Kept only hardware description (GPIO, PHY, LEDs, keys, PCIe, USB, WiFi)
 */

#include "ipq8074.dtsi"
#include "ipq8074-hk-cpu.dtsi"

/ {
	model = "Swaiot CPE-S10-SKY";
	compatible = "swaiot,cpe-s10-sky", "qcom,ipq8074";

	aliases {
		serial0 = &blsp1_uart5;
		led-boot = &sys_red;
		led-failsafe = &sys_red;
		led-running = &sys_blue;
		led-upgrade = &sys_blue;
	};

	chosen {
		stdout-path = "serial0";
	};
};

&tlmm {
	button_pins: button-pins {
		reset {
			pins = "gpio34";
			function = "gpio";
			bias-pull-up;
		};
		wps {
			pins = "gpio50";
			function = "gpio";
			bias-pull-up;
		};
	};

	led_pins: led-pins {
		4gyellow { pins = "gpio42"; function = "gpio"; };
		4gblue  { pins = "gpio43"; function = "gpio"; };
		sys_blue_pin { pins = "gpio51"; function = "gpio"; };
		sys_red_pin  { pins = "gpio52"; function = "gpio"; };
		ethblue { pins = "gpio55"; function = "gpio"; };
		ethyellow { pins = "gpio56"; function = "gpio"; };
		5gblue { pins = "gpio63"; function = "gpio"; };
		5gyellow { pins = "gpio64"; function = "gpio"; };
	};
};

&blsp1_uart5 {
	status = "okay";
};

&spi_0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;
	};
};

&nand {
	status = "okay";
};

&usb3_0 {
	status = "okay";
};

&usb3_1 {
	status = "okay";
};

&pcie0 {
	status = "okay";
	perst-gpios = <&tlmm 58 GPIO_ACTIVE_LOW>;
};

&mdio {
	status = "okay";

	phy2: ethernet-phy@2 { reg = <2>; };
	phy3: ethernet-phy@3 { reg = <3>; };
	phy4: ethernet-phy@18 { reg = <24>; };
};

&switch {
	status = "okay";

	switch_ports: ports {
		port@0 {
			reg = <0>;
			label = "cpu";
			ethernet = <&gmac0>;
			phy-mode = "sgmii";
		};

		port@3 {
			reg = <3>;
			label = "lan1";
			phy-handle = <&phy2>;
		};

		port@4 {
			reg = <4>;
			label = "lan2";
			phy-handle = <&phy3>;
		};

		port@5 {
			reg = <5>;
			label = "wan";
			phy-handle = <&phy4>;
		};
	};
};

&gpio_keys {
	status = "okay";
	pinctrl-0 = <&button_pins>;

	reset {
		label = "reset";
		linux,code = <KEY_RESTART>;
		gpios = <&tlmm 34 GPIO_ACTIVE_LOW>;
	};

	wps {
		label = "wps";
		linux,code = <KEY_WPS_BUTTON>;
		gpios = <&tlmm 50 GPIO_ACTIVE_LOW>;
	};
};

&leds {
	status = "okay";
	pinctrl-0 = <&led_pins>;

	sys_blue: blue {
		label = "cpe-s10-sky:blue";
		gpios = <&tlmm 51 GPIO_ACTIVE_LOW>;
	};

	sys_red: red {
		label = "cpe-s10-sky:red";
		gpios = <&tlmm 52 GPIO_ACTIVE_LOW>;
	};
};

&wifi0 {
	status = "okay";
	qcom,board_id = <0x92>;
};

&wifi1 {
	status = "okay";
	qcom,board_id = <0x292>;
};
