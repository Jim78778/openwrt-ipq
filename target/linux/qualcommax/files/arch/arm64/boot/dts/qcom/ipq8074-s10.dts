/dts-v1/;

#include "ipq8074.dtsi"
#include "ipq8074-hk-cpu.dtsi"
#include "ipq8074-ess.dtsi"
#include "ipq8074-nss.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Swaiot CPE-S10-SKY";
	compatible = "swaiot,cpe-s10-sky", "qcom,ipq8074";

	aliases {
		serial0 = &blsp1_uart3;
		ethernet0 = &dp5;
		ethernet1 = &dp3;
		ethernet2 = &dp4;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs-append = " swiotlb=1 coherent_pool=2M";
	};

	dummy_reg: dummy-regulator {
		compatible = "regulator-fixed";
		regulator-name = "dummy";
		regulator-min-microvolt = <0>;
		regulator-max-microvolt = <0>;
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		sys_blue: blue {
			label = "s10:blue";
			gpios = <&tlmm 51 GPIO_ACTIVE_LOW>;
		};

		sys_red: red {
			label = "s10:red";
			gpios = <&tlmm 52 GPIO_ACTIVE_LOW>;
		};
	};
};

&tlmm {
	mdio_pins: mdio_pinmux {
		mux_0 {
			pins = "gpio68";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};
		mux_1 {
			pins = "gpio69";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	led_pins: led_pins {
		blue {
			pins = "gpio51";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
		red {
			pins = "gpio52";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
	};
};

&blsp1_uart3 {
	status = "okay";
};

&qpic_nand {
	status = "okay";

	nand@0 {
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		nand-bus-width = <8>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "ubi";
				reg = <0x00000000 0x0fa00000>;
			};

			partition@0fa00000 {
				label = "ART";
				reg = <0x0fa00000 0x00400000>;
				read-only;
			};
		};
	};
};

&mdio {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";

	reset-gpios = <&tlmm 37 GPIO_ACTIVE_LOW>;

	phy2: ethernet-phy@2 {
		reg = <2>;
	};

	phy3: ethernet-phy@3 {
		reg = <3>;
	};

	phy4: ethernet-phy@24 {
		reg = <24>;
		compatible = "ethernet-phy-id004d.d101";
	};
};

&switch {
	status = "okay";

	switch_cpu_bmp = <0x1>;
	switch_lan_bmp = <0x18>;  /* port3 + port4 */
	switch_wan_bmp = <0x20>;  /* port5 */
};

&dp5 {
	status = "okay";
	label = "wan";
	phy-mode = "usxgmii";
	phy-handle = <&phy4>;
};

&dp3 {
	status = "okay";
	label = "lan1";
	phy-mode = "qsgmii";
	phy-handle = <&phy2>;
};

&dp4 {
	status = "okay";
	label = "lan2";
	phy-mode = "qsgmii";
	phy-handle = <&phy3>;
};

&wifi {
	status = "okay";
	qcom,ath11k-fw-memory-mode = <0>;
	qcom,ath11k-calibration-variant = "Swaiot-CPE-S10-SKY";
};

&nss0 {
	qcom,low-frequency = <187200000>;
	qcom,mid-frequency = <748800000>;
	qcom,max-frequency = <1497600000>;
	npu-supply = <&dummy_reg>;
	mx-supply = <&dummy_reg>;
};

&npu_cpr {
	status = "disabled";
};

&pcie0 {
	status = "okay";
	perst-gpios = <&tlmm 58 GPIO_ACTIVE_LOW>;
	wake-gpios = <&tlmm 59 GPIO_ACTIVE_HIGH>;
};
