// SPDX-License-Identifier: GPL-2.0
/dts-v1/;

#include "ipq8074.dtsi"
#include <dt-bindings/input/input.h>

/ {
	model = "Swaiot / Skyworth CPE-S10";
	compatible = "swaiot,cpe-s10-sky", "qcom,ipq8074";

	aliases {
		serial0 = &blsp1_uart3;
		ethernet0 = &dp1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs-append = " rootfstype=squashfs";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x40000000>; /* 1GB */
	};
};

/* =========================
 * UART（必须，救砖）
 * ========================= */
&blsp1_uart3 {
	status = "okay";
};

/* =========================
 * NAND / MTD（严格按你 /proc/mtd）
 * ========================= */
&qcom_nand {
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "rootfs";
			reg = <0x00000000 0x0fa00000>;
		};

		partition@fa00000 {
			label = "0:SBL1";
			reg = <0x0fa00000 0x00050000>;
			read-only;
		};

		partition@fa50000 {
			label = "0:MIBIB";
			reg = <0x0fa50000 0x00010000>;
			read-only;
		};

		partition@fa60000 {
			label = "0:BOOTCONFIG";
			reg = <0x0fa60000 0x00020000>;
			read-only;
		};

		partition@fa80000 {
			label = "0:BOOTCONFIG1";
			reg = <0x0fa80000 0x00020000>;
			read-only;
		};

		partition@faa0000 {
			label = "0:QSEE";
			reg = <0x0faa0000 0x00180000>;
			read-only;
		};

		partition@fc20000 {
			label = "0:QSEE_1";
			reg = <0x0fc20000 0x00180000>;
			read-only;
		};

		partition@fda0000 {
			label = "0:DEVCFG";
			reg = <0x0fda0000 0x00010000>;
			read-only;
		};

		partition@fdb0000 {
			label = "0:DEVCFG_1";
			reg = <0x0fdb0000 0x00010000>;
			read-only;
		};

		partition@fdc0000 {
			label = "0:APDP";
			reg = <0x0fdc0000 0x00010000>;
			read-only;
		};

		partition@fdd0000 {
			label = "0:APDP_1";
			reg = <0x0fdd0000 0x00010000>;
			read-only;
		};

		partition@fde0000 {
			label = "0:RPM";
			reg = <0x0fde0000 0x00040000>;
			read-only;
		};

		partition@fe20000 {
			label = "0:RPM_1";
			reg = <0x0fe20000 0x00040000>;
			read-only;
		};

		partition@fe60000 {
			label = "0:CDT";
			reg = <0x0fe60000 0x00010000>;
			read-only;
		};

		partition@fe70000 {
			label = "0:CDT_1";
			reg = <0x0fe70000 0x00010000>;
			read-only;
		};

		partition@fe80000 {
			label = "0:APPSBLENV";
			reg = <0x0fe80000 0x00010000>;
			read-only;
		};

		partition@fe90000 {
			label = "0:APPSBL";
			reg = <0x0fe90000 0x000a0000>;
			read-only;
		};

		partition@ff30000 {
			label = "0:APPSBL_1";
			reg = <0x0ff30000 0x000a0000>;
			read-only;
		};

		partition@ffd0000 {
			label = "0:ART";
			reg = <0x0ffd0000 0x00040000>;
			read-only;
		};

		partition@10010000 {
			label = "0:ETHPHYFW";
			reg = <0x10010000 0x00080000>;
			read-only;
		};

		partition@10090000 {
			label = "ledeinfo";
			reg = <0x10090000 0x00010000>;
		};

		partition@100a0000 {
			label = "reserve";
			reg = <0x100a0000 0x00010000>;
		};
	};
};

/* =========================
 * Ethernet（最小可用）
 * ========================= */
&dp1 {
	status = "okay";
};

&dp2 {
	status = "okay";
};

/* =========================
 * Wi-Fi（关键：board-2.bin）
 * ========================= */
&wifi {
	status = "okay";

	qcom,ath11k-calibration-variant = "cpe_s10_sky";
};

/* =========================
 * PCIe（给 WWAN / Wi-Fi）
 * ========================= */
&pcie0 {
	status = "okay";
};

&pcie1 {
	status = "okay";
};

/* =========================
 * USB（调试 & LTE）
 * ========================= */
&usb0 {
	status = "okay";
};

&usb1 {
	status = "okay";
};
